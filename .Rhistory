data_test <- read.csv("test_data.csv")
wr <- winratio(id = "id", trt = "trt", active = "Treatment",
outcomes = list(outc1 = c("death", "s", "t2death"),
outc2 = list(paste0("recurr", 1:9), "r", paste0("t2recurr", 1:9)),
outc3 = c("size", "c", ">")),
fu = "t2death", data = data_test)
df <- plot.WinRatio(wr)
winRatioPlot(df)
