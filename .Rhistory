test_func <- function(x, level) {
output <- match.arg(level)
output
}
test_func(level = "cat")
test_func <- function(x, level=dog) {
output <- match.arg(level)
output
}
test_func(x=2, level = "cat")
test_func <- function(x, level=dog) {
output <- match.call(level)
outputname <- ("level" %in% names(output))
outputname
}
test_func(x=2, level = "cat")
test_func <- function(x, level=dog) {
output <- match.call()
outputname <- ("level" %in% names(output))
outputname
}
test_func(x=2, level = "cat")
test_func <- function(x, level=dog) {
output <- match.call()
outputname <- ("level" %in% names(output))
return(outputname)
}
test_func(x=2, level = "cat")
test_func <- function(x, level) {
output <- match.call()
outputname <- ("level" %in% names(output))
return(outputname)
}
test_func(x=2, level = "cat")
